<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvCurrentCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="UFO Sinyal Çözücü Hazır"
            android:textColor="#00E676"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 1. Hızlı Profil Taraması -->
        <Button
            android:id="@+id/btnScanProfiles"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:backgroundTint="#D32F2F"
            android:text="1. BİLİNEN TÜM PROFİLLERİ TARA (60 KOD)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- 2. Brute Force 256 Komut -->
        <Button
            android:id="@+id/btnBruteForce"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:backgroundTint="#FF6D00"
            android:text="2. BRUTE-FORCE TARA (0x00 -> 0xFF)"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Durdur ve Yakala -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#D50000"
            android:text="DURDUR / KODU YAKALA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Manuel İnce Ayar Kontrolleri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#424242"
                android:text="◀ 1 GERİ"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnResend"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="#2979FF"
                android:text="TEKRAR AT"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#424242"
                android:text="1 İLERİ ▶"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Bip sesi duyduğunuz an DURDUR'a basın."
            android:textColor="#888888"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
