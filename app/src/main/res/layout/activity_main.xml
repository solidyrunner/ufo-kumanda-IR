<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="UFO Tam Kapsamlı Tarayıcı"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Hazır (Toplam 256 Komut)"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- 256 Kodluk Tam Brute-Force Taraması -->
        <Button
            android:id="@+id/btnFullScan"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#FF6D00"
            android:text="TÜM 256 VARYASYONU TARA (UZUN SİNYAL)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Bip Sesi Gelince Durdur -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:backgroundTint="#D50000"
            android:text="DURDUR / KODU YAKALA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginBottom="16dp" />

        <!-- İnce Ayar Kontrolleri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#424242"
                android:text="◀ 1 GERİ"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnResend"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="#2979FF"
                android:text="TEKRAR AT"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#424242"
                android:text="1 İLERİ ▶"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Hızlı Tekil Adaylar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Doğrudan Tekli Kodlar:"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnQuickA8"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#37474F"
            android:text="Dene: 0xA8 (Orijinal Power)"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnQuickA2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#37474F"
            android:text="Dene: 0xA2 (Kademe +)"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnQuick80"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#37474F"
            android:text="Dene: 0x80 (Standart Power)" />

    </LinearLayout>
</ScrollView>
