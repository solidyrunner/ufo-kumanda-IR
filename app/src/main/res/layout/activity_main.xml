<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="UFO UK/L (Adres: 0x70) Paneli"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 1. Gerçek Orijinal UFO Power (Adres: 0x70, Komut: 0xA8) -->
        <Button
            android:id="@+id/btnRealPower"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:backgroundTint="#D32F2F"
            android:text="UFO ORİJİNAL POWER (0x70, 0xA8)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- 2. Kademe Artır (H0 -> H1) -->
        <Button
            android:id="@+id/btnLevelUp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#1976D2"
            android:text="KADEME YÜKSELT (+) (0x70, 0xA2)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- 3. Kademe Azalt -->
        <Button
            android:id="@+id/btnLevelDown"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#1976D2"
            android:text="KADEME DÜŞÜR (-) (0x70, 0x90)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- 0x70 Adresindeki Tüm Komutları Tara -->
        <Button
            android:id="@+id/btnScan0x70"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#FF6D00"
            android:text="0x70 ADRESİNDEKİ TÜM KOMUTLARI TARA"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Farklı Olası Adresleri Tara (0x70, 0x40, 0x86, 0x01) -->
        <Button
            android:id="@+id/btnScanAddresses"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#7B1FA2"
            android:text="FARKLI ADRESLERİ TARA (0x40, 0x86, 0x01)"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#424242"
            android:text="DURDUR"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
