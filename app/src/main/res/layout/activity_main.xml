<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="UFO Sinyal Tarayıcı"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- 1 Numaralı Asıl Aday: LIRC Orijinal UFO Kodu -->
        <Button
            android:id="@+id/btnMainCandidate"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:backgroundTint="#E53935"
            android:text="ORİJİNAL UFO POWER (0xA857)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Otomatik Tümünü Tara -->
        <Button
            android:id="@+id/btnAutoScan"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#FB8C00"
            android:text="OTOMATİK TARA (TÜM LİSTE)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStopScan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#424242"
            android:text="TARAMAYI DURDUR"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tekli Aday Denemeleri:"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAlt1"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#1E88E5"
            android:text="Dene: 0x02FD (Micatronic Power)"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnAlt2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#1E88E5"
            android:text="Dene: 0x10EF (UFO Star Power)"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnAlt3"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#1E88E5"
            android:text="Dene: RC-5 36kHz (Philips Protokol)"
            android:layout_marginBottom="6dp" />

    </LinearLayout>
</ScrollView>
