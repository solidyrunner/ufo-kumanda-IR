<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="UFO UK/L Panel Kontrolü (H0-H5)"
            android:textColor="#4CAF50"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Asıl UFO UK/L Açma/Kapama Tuşu -->
        <Button
            android:id="@+id/btnPower"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:backgroundTint="#E53935"
            android:text="AÇ / KAPAT (POWER)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- H0'dan H1'e Geçiren Kademe Butonları -->
        <Button
            android:id="@+id/btnLevelUp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#1E88E5"
            android:text="KADEME YÜKSELT (+)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnLevelDown"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#1E88E5"
            android:text="KADEME DÜŞÜR (-)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- Tek Tuşla Uyandırma (Power + Kademe + Arka Arkaya) -->
        <Button
            android:id="@+id/btnForceWake"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#8E24AA"
            android:text="ZORLA UYANDIR (H0 -> H1)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Otomatik Tarayıcı -->
        <Button
            android:id="@+id/btnScanAll"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#FB8C00"
            android:text="TÜM UFO VARYASYONLARINI TARA"
            android:textColor="#000000"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
